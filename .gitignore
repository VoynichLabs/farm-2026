# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenClaw agent-workspace scaffolding — NOT part of the website. Default
# boilerplate an OpenClaw run drops in its working dir; deleted 2026-06-23 and
# ignored here so a future run in this repo can't re-add them. Also ignore the
# stray flock-profiles JSON backups agents leave behind.
/.openclaw/
/.openclaw-cli-images/
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/content/flock-profiles.json.bak.*
